      "author_masked": "ว***",
      "app_name": "Play Together VNG",
      "app_id": "com.vng.playtogether",
      "text_th": "พอออกจากเกมแปปเดียว เกมหลุดต้องล็อกอินใหม่ พอกลับไปใช้โค้ดบัญชีสำหรับย้ายมา vng กลับใช้โค้ดไม่ได้ แล้วจะล็อกอินอีกรอบยังไง พึ่งซื้อไอเทมในเกมไป แล้วของในเกมก็แพงขึ้นทุกอย่าง แต่ระบบกลับแย่มาก",
      "text_vn": "Vừa thoát game một chút là bị văng, phải đăng nhập lại. Quay lại dùng code chuyển tài khoản sang VNG thì lại không dùng được, vậy giờ đăng nhập lại kiểu gì? Vừa mới mua vật phẩm trong game xong. Đồ trong game cái gì cũng đắt hơn mà hệ thống lại tệ quá.",
      "translation_method": "ai_contextual",
      "sentiment": "Negative",
      "confidence": 0.75,
      "topic": "Login / Account / Data",
      "topic_secondary": [],
      "theme": "Đăng nhập tài khoản",
      "segment": "unknown",
      "severity": null,
      "needs_review": true,
      "rating": 1,
      "intent": "account",
      "keywords": [
        "đăng nhập",
        "chuyển tài khoản vng",
        "giá vật phẩm"
      ],
      "summary_vn": "Bị đăng xuất, code chuyển tài khoản không dùng lại được.",
      "label_method": "ai_review",
      "content_kind": "review",
      "activity_type": "Đánh giá store",
      "date_basis": "published_at",
      "store_sentiment": "Unhappy",
      "store_tags": [
        "Login",
        "Payment",
        "Performance And Bugs"
      ],
      "app_version": "2.29.0",
      "text_en": "I left the game for a moment and got kicked out and had to log in again. I tried the account transfer code to VNG again but it doesn't work, so how am I supposed to log back in? I just bought items in the game. Everything in the game is more expensive and the system is so bad.",
      "summary_en": "Logged out, and the account transfer code can't be reused."
    },
